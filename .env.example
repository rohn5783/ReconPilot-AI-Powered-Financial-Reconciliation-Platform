# ReconPilot Environment Configuration Example

# Server Environment: development | production
ENVIRONMENT=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# MongoDB Connection String & Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=reconpilot
MONGODB_TIMEOUT=10s

# Redis Connection String
REDIS_URL=redis://localhost:6379/0

# Pipeline Configuration
PIPELINE_MAX_CONCURRENT_HOSTS=10
PIPELINE_STAGE_TIMEOUT=5m
PIPELINE_RING_BUFFER_SIZE_KB=1024

# Security Scoping & Verification
SECURITY_ALLOWED_ROOT_DOMAINS=acme.org
SECURITY_ENFORCE_DNS_VERIFICATION=false

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API Authentication Key
AUTH_API_KEY=reconpilot-secret-dev-key

# Synthetic Reconnaissance Mode (true for offline demo/testing without tool binaries)
MOCK_MODE=false
