# Reconciliation Pipeline Limits
PIPELINE_MAX_CONCURRENT_BATCHES=10
PIPELINE_STAGE_TIMEOUT=5m
PIPELINE_RING_BUFFER_SIZE_KB=2048

# Security & Verification
SECURITY_ENFORCE_STRICT_SCHEMA=true

# Google Gemini API Key (Diagnosis Engine)
GEMINI_API_KEY=<KEY_HERE>
GEMINI_MODEL=gemini-2.5-flash

# API Authentication Key
AUTH_API_KEY=reconpilot-secret-dev-key

# MOCK_MODE (true for offline demo/testing without database/live CSVs)
MOCK_MODE=false

# Auto-seed realistic data on startup if DB is empty
AUTO_SEED_ON_EMPTY=true

# Database & Server
DATABASE_URL=postgres://reconpilot:reconpilot@localhost:5432/reconpilot?sslmode=disable
PORT=8080

