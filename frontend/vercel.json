{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://reconpilot-backend-latest.onrender.com/api/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://reconpilot-backend-latest.onrender.com/healthz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
