# Reconciliation Pipeline Limits
PIPELINE_MAX_CONCURRENT_BATCHES=10
PIPELINE_STAGE_TIMEOUT=5m
PIPELINE_RING_BUFFER_SIZE_KB=2048

# Security & Verification
SECURITY_ENFORCE_STRICT_SCHEMA=true

# Contract Rates & Matching Thresholds (Dynamic)
CONTRACT_FEE_RATE=0.0200
CONTRACT_TAX_RATE=0.1800
FEE_TOLERANCE=0.0100

# Google Gemini API Key (Diagnosis Engine)
GEMINI_API_KEY=<KEY_HERE>
GEMINI_MODEL=gemini-2.5-flash

# API Authentication Key (Optional for open dev)
AUTH_API_KEY=

# MOCK_MODE (true for in-memory testing without postgres)
MOCK_MODE=false

# Auto-seed realistic demo data on startup (false: zero hardcoded data injected)
AUTO_SEED_ON_EMPTY=false

# Database & Server
DATABASE_URL=postgres://reconpilot:reconpilot@localhost:5432/reconpilot?sslmode=disable
PORT=8080
LIVE_BACKEND_URL=https://reconpilot-backend-latest.onrender.com

